{
  "name": "voidflippr",
  "version": "2.0.0",
  "private": true,
  "description": "VoidFlippr - a daily Lights Out puzzle game with a global leaderboard.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
