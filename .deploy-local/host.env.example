# VoidFlippr - local deployment target
#
# Gitignored. Never commit this file.
#
# Fill in the LXC's LAN address and deploy over SSH. The matching private
# key is at .deploy-local/id_ed25519 (mode 0600); install the public key
# (.deploy-local/id_ed25519.pub) in the container's authorized_keys.
#
#   ssh-copy-id -i .deploy-local/id_ed25519.pub <user>@<host>

# LAN address of the LXC, e.g. 192.168.1.50
VH_HOST=

# SSH port (22 unless you changed it)
VH_PORT=22

# SSH user with sudo in the container
VH_USER=root

# Where the app lives inside the container
VH_APP_DIR=/opt/voidflippr

# Private key for the SSH connection
VH_KEY=.deploy-local/id_ed25519

# Port the game listens on inside the container
VH_APP_PORT=9865
